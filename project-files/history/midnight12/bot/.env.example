# Local-only template. Never commit real values or send this file with secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Use the bot_app PostgreSQL role, not postgres. Copy host/port from Supabase Connect.
# Percent-encode reserved characters in the URI password (for example @, #, ?, /).
DATABASE_URL=
BOT_TIME_ZONE=Europe/Moscow
# Only for a private/local test environment. Do not enable on a public bot.
BOT_PREVIEW_MODE=1
